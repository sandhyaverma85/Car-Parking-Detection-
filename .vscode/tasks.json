{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Seed Database",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["scripts/seed_db.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "2. Start Backend Server",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/uvicorn.exe",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "3. Start Frontend (Vite)",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/c", "npm.cmd run dev"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "4. Run AI Ingestion Pipeline",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["ai_engine/pipeline.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "5. Run All Tests",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/pytest.exe",
      "args": ["backend/tests", "-v"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
