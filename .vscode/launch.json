{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI Backend (Port 8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "jinja": true
    },
    {
      "name": "AI Pipeline (YOLO + ByteTrack)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ai_engine/pipeline.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Run Backend Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "backend/tests"
      ],
      "cwd": "${workspaceFolder}"
    }
  ]
}
