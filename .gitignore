# ─── Secrets & Environment ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
.venv.zip
*.pem
*.key

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
dist/
build/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
*.whl
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.log

# ─── AI / ML ──────────────────────────────────────────────────────────────────
# Large model weights — download separately, never commit
*.pt
*.pth
*.onnx
*.engine
*.trt
runs/

# ─── Evidence & Data ─────────────────────────────────────────────────────────
# Evidence frames contain sensitive video stills — served via authenticated API
evidence/*
!evidence/.gitkeep

# Sample videos — too large for git; use git-lfs or external storage
data/videos/*
!data/videos/.gitkeep

# ─── Node / Frontend ─────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local
.npm
*.tsbuildinfo

# ─── Docker ──────────────────────────────────────────────────────────────────
# Override files may contain local secrets
docker-compose.override.yml

# ─── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─── Database ────────────────────────────────────────────────────────────────
*.sqlite3
*.db
pgdata/

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
