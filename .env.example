# =============================================================================
# AI-Powered Smart Curb & Parking Intelligence Platform
# Environment Configuration Template
#
# COPY THIS FILE TO .env AND FILL IN REAL VALUES.
# NEVER commit .env to version control.
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string with PostGIS extension
DATABASE_URL=postgresql://parking_user:CHANGE_ME@localhost:5432/parking_db

# ─── Backend Security ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
# Token lifetime in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Backend Server ───────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=false

# ─── AI / Computer Vision ────────────────────────────────────────────────────
# Path to YOLO model weights; relative to ai_engine/ or absolute
MODEL_PATH=yolov8n.pt
# Detection confidence threshold (0.0 – 1.0)
CONFIDENCE_THRESHOLD=0.5
# IoU threshold for NMS
IOU_THRESHOLD=0.45
# Process every Nth frame to reduce CPU/GPU load (1 = every frame)
FRAME_SKIP=2
# Violation persistence: vehicle must be in zone for this many seconds
VIOLATION_DURATION_SECONDS=120
# Minimum IoU overlap between vehicle bbox and parking slot polygon
PARKING_OVERLAP_THRESHOLD=0.3

# ─── Video Ingestion ─────────────────────────────────────────────────────────
# Options: "file", "webcam", "rtsp"
VIDEO_SOURCE_TYPE=file
# For "file": relative path from project root or absolute path
VIDEO_FILE_PATH=data/videos/sample.mp4
# For "webcam": device index (0 = default camera)
WEBCAM_INDEX=0
# For "rtsp": stored as a template; replace with real credentials at runtime
# Format: rtsp://USER:PASSWORD@HOST:PORT/STREAM_PATH
# RTSP credentials are NEVER logged or exposed to the frontend
RTSP_URL=rtsp://USER:PASSWORD@192.168.1.100:554/stream1

# ─── Evidence Storage ────────────────────────────────────────────────────────
# Directory where violation evidence frames are stored
# Must be OUTSIDE the frontend's public/static directories
EVIDENCE_DIR=evidence
# Max evidence image size in bytes (default 5 MB)
EVIDENCE_MAX_SIZE_BYTES=5242880

# ─── Maps / Geocoding ────────────────────────────────────────────────────────
# Public Nominatim endpoint — respect usage policy (max 1 req/sec, set UA)
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SmartParkingPlatform/1.0

# Optional: OpenRouteService for routing
# Get a free key at https://openrouteservice.org
OPENROUTESERVICE_API_KEY=CHANGE_ME

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max login attempts per IP per minute
LOGIN_RATE_LIMIT=5
# Max general API requests per IP per minute
API_RATE_LIMIT=60

# ─── Logging ─────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ─── Docker / Deployment (override in docker-compose or CI/CD) ───────────────
POSTGRES_USER=parking_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=parking_db
